{
  "name": "michat-backend",
  "version": "1.0.0",
  "description": "MiChat Backend - Real-time Chat Application API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
