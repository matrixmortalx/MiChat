    "socket.io": "^4.6.1",
    "pg": "^8.10.0",
    "redis": "^4.6.5",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.3",
    "joi": "^17.9.1",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1371.0",
    "cloudinary": "^1.33.0",
    "nodemailer": "^6.9.1",
    "twilio": "^3.77.2",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-apple": "^2.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.7.0",
